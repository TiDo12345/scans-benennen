# Kopieren nach .env und anpassen. .env bleibt lokal (steht in .gitignore).
# Ordner, in den der Scanner seine PDFs legt (auf dem Rechner, auf dem Docker läuft)
SCAN_ORDNER=/pfad/zu/scans
# Benutzer, unter dem der Container läuft: braucht Lese-/Schreibrecht auf SCAN_ORDNER (id -u / id -g)
SCAN_UID=1000
SCAN_GID=1000
